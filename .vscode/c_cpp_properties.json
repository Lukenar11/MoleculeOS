// DESCRIPTION:
//     This makes VS Code know under which paths the files are located
//

{
    "version": 4,
    "configurations": [
        {
            "name": "MoleculeOS",
            "compilerPath": "clang++",
            "intelliSenseMode": "clang-x86",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/kernel/include",
                "${workspaceFolder}/kernel/include/heap",
                "${workspaceFolder}/kernel/include/filesystem",
                "${workspaceFolder}/runtime/cpp/include",
                "${workspaceFolder}/runtime/apis",
                "${workspaceFolder}/runtime/apis/arch",
                "${workspaceFolder}/arch/i386/runtime/include",
                "${workspaceFolder}/arch/i386/kernel/include/idt",
                "${workspaceFolder}/arch/i386/kernel/include/irq",
                "${workspaceFolder}/arch/i386/kernel/include/isr",
                "${workspaceFolder}/arch/i386/kernel/include/system",
                "${workspaceFolder}/arch/i386/kernel/include",
                "${workspaceFolder}/drivers/include/ata",
                "${workspaceFolder}/drivers/include/ps2",
                "${workspaceFolder}/drivers/include/vga",
                "${workspaceFolder}/drivers/include/utils/",
                "${workspaceFolder}/shell/include",
                "${workspaceFolder}/shell/include/commands",
                "${workspaceFolder}/shell/include/utils"
            ],
            "defines": [
                "__I386__"
            ]
        }
    ]
}
