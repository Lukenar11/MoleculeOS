// DESCRIPTION:
//     This makes VS Code know under which paths the files are located.
//

{
    "version": 4,
    "configurations": [
        {
            "name": "MoleculeOS",
            "compilerPath": "clang++",
            "intelliSenseMode": "clang-x86",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/kernel/include",
                "${workspaceFolder}/kernel/include/heap",
                "${workspaceFolder}/kernel/include/idt",
                "${workspaceFolder}/runtime/c/include",
                "${workspaceFolder}/runtime/cpp/include",
                "${workspaceFolder}/arch/i386/runtime/include",
                "${workspaceFolder}/drivers/ps2/keyboardin/include",
                "${workspaceFolder}/drivers/ps2/keyboardin/include/utils",
                "${workspaceFolder}/drivers/vga/textmode/include",
                "${workspaceFolder}/drivers/vga/textmode/include/utils",
                "${workspaceFolder}/shell/include",
                "${workspaceFolder}/shell/include/interpreter",
                "${workspaceFolder}/shell/include/commands"
            ],
            "defines": [
                "__MOLECULE_OS__",
                "__KERNEL__"
            ]
        }
    ]
}
