// DESCRIPTION:
//     This is the VS Code editor configuration.
// 

{
    "files.eol": "\n",

    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": false,
    "editor.detectIndentation": false,
        "files.associations": {
        "*.asm": "nasm"
    },

    "search.exclude": {
        "build": true
    },
    "C_Cpp.errorSquiggles": "disabled"
}
