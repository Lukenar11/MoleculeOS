// DESCRIPTION:
//     This is the VS Code editor configuration.
// 

{
    "files.eol": "\n",

    "editor.tabSize":           4,
    "editor.insertSpaces":      true,
    "editor.formatOnSave":      false,
    "editor.detectIndentation": false,
        "files.associations": {
        "*.asm": "nasm"
    },

    "search.exclude": {
        "build": true
    },

    "C_Cpp.errorSquiggles": "disabled",
    
    "cSpell.words": [
        "ABRT",
        "ACPI",
        "allocinfo",
        "AMNF",
        "Bochs",
        "DRDY",
        "eflags",
        "endmacro",
        "endrep",
        "filesys",
        "IDNF",
        "INOUT",
        "insw",
        "intstrem",
        "iretd",
        "lgdt",
        "lidt",
        "Lukenar",
        "Matthes",
        "mofs",
        "multiboot",
        "nasm",
        "Netwide",
        "outstrem",
        "outsw",
        "popf",
        "pushf",
        "redict",
        "resb",
        "rodata",
        "SCANCODE",
        "SRST",
        "storemgr",
        "testsuit"
    ]
}
