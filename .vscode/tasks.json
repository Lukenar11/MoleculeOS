{
    "version": "2.0.0",
    "tasks":   [
        {
            "label":   "Build MoleculeOS",
            "type":    "shell",
            "command": "./tools/build.sh",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "wsl.exe"
                }
            },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label":   "Run MoleculeOS",
            "type":    "shell",
            "command": "./tools/run.sh",
            "options": {
                "cwd":   "${workspaceFolder}",
                "shell": {
                    "executable": "wsl.exe"
                }
            }
        }
    ]
}
